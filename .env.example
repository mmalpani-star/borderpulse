# Live zero-touch broadcast via Vapi. Copy to .env.local (gitignored) and fill in. Never commit real values.
# Without these, the console runs a clearly labeled simulated broadcast.
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
# The only number a live call can ring (E.164, e.g. +15555550123). Set server-side; the browser cannot choose it.
DRIVER_PHONE_NUMBER=
